// omp-toolgate — a baseline tool_permissions policy.
//
// Copy this file to ~/.omp/agent/tool-permissions.json. It is usable unedited,
// and it is meant to be trimmed: see "If confirmations get noisy" below. This is
// a Zed `agent.tool_permissions` block, so the same content also works pasted
// into ~/.config/zed/settings.json under "agent".
//
// WHAT THIS IS NOT. It is a starting point, not a guarantee. Everything below is
// pattern matching over the strings omp-toolgate can see, so a program that
// derives its target at runtime is out of reach by construction. Read
// "Known limits" in the README before trusting any of it.
//
// POSTURE: allow by default, confirm what is hard to undo or moves credentials.
// There is exactly one "deny" (`computer`). A policy that refuses often is a
// policy that gets switched off, and a confirmation you can answer is worth more
// than a wall you route around.
//
// IF CONFIRMATIONS GET NOISY, delete in this order:
//   1. `delete_path.default` — every delete tool call asks, build output included.
//      Its `always_confirm` list is what keeps credentials protected after you
//      relax the default, so relax the default and keep the list.
//   2. `terminal`'s `ssh` entry, if you work on remote hosts all day. It is in
//      the exfiltration list because `ssh host < .env` sends a file off this
//      machine and nothing else here can see that: a read redirect is not a
//      write target.
//   3. `terminal`'s package-manager rule (`npm install`, `npm i` and friends).
//   4. `terminal`'s `npx` / `bunx` / `dlx` rule.
//   5. `terminal`'s interpreter rule, if you run `node -e` all day.
//   6. `read_file`'s credential patterns, if a tool you use reads `.env` on
//      every call. This is the last one to go: confirming a write to a private
//      key while allowing a read of it protects nothing.
// The `{ "scope": "outside" }` rules are the boundary omp itself does not have.
// Delete them only if you routinely write outside the repository you are in. The
// case that surprises people is a shell redirection: `npm test > /tmp/out.log`
// confirms, because the redirect target is judged as a `write_file` and /tmp is
// outside the project. `> /dev/null` never is.
//
// WHAT STILL WALKS PAST THE COMMAND RULES. Each rule that names a program is
// anchored at the start of one sub-command, because an unanchored `\btee\b` also
// fires on the word `tee` in a commit message. The anchor steps over assignment
// prefixes, a path (`/usr/bin/tee`), and the wrapper programs named in the rules
// themselves — but it cannot step over what it has not been told about:
//   `xargs -0 tee ...`    a wrapper carrying its own flags
//   `P=/usr/bin/tee; $P`  a program named by a variable the shell expands later
//   `foo | bar tee ...`   `tee` as an argument to a program that is not `ssh`
// The first two are why `terminal` alone is not a boundary. The `write_file`
// rules cover what the shell itself opens; nothing covers what a program the
// rules cannot name decides to open.
//
// SEARCH IS NOT GATED. `grep` and `find_path` carry no rules here, and a search
// is a real read channel: grep output contains the matching lines. Confirming
// every search is the fastest way to make a gate unbearable, so it is left to
// you. To add it (both the pattern text and each search root are matched):
//   "grep": { "always_confirm": [{ "pattern": "(^|/)\\.env" }] }
//
// PLAIN `curl` AND `wget` FETCHES ARE ALLOWED, deliberately. Uploads (`-T`,
// `--upload-file`, an `@file` request body) and piping a download into an
// interpreter are confirmed, because those are the exfiltration and
// remote-code shapes. A plain fetch is also the most ordinary command in a
// developer session, and omp's own `fetch` and `web_search` tools cover the same
// ground under their own names. To confirm them anyway, add to `terminal`:
//   { "pattern": "\\b(curl|wget)\\b" }
//
// MCP TOOLS ARE NOT COVERED: their names depend on the servers you connect.
// The key is `mcp:<server>:<tool>`, and omp's own `mcp__server__tool` spelling
// is accepted too. Every string argument of an MCP call is offered as an input,
// so one pattern can match any of them:
//   "mcp:context7:query-docs": { "default": "confirm" }
//
// ALSO NOT COVERED: `fetch`, `skill` and `spawn_agent` keep the global default.
// `eval`, `browser` and `computer` carry no matchable input at all, which is why
// they appear here with a `default` and nothing else.
//
// COMMENTS DO NOT SURVIVE. Answering an approval prompt with
// "Always allow (global)" re-serializes this file as plain JSON, and every
// comment above and below is gone. Keep an unedited copy, or prefer the
// "this project" choice, which writes `<project_root>/.omp/tool-permissions.json`
// instead. Never symlink this file to your Zed settings.json: the first
// write-back would rewrite that file as plain JSON as well.
{
  "default": "allow",
  "tools": {
    // ---------------------------------------------------------------------
    // The mutating family. `outside` is the project-root boundary; the
    // patterns are the credential paths a mistake there is unrecoverable.
    // ---------------------------------------------------------------------
    "write_file": {
      "default": "allow",
      "always_confirm": [
        { "scope": "outside" },
        { "pattern": "(^|/)\\.(ssh|aws|gnupg|kube|azure)(/|$)" },
        { "pattern": "(^|/)\\.config/(gcloud|gh)(/|$)" },
        { "pattern": "(^|/)(\\.netrc|\\.git-credentials|\\.npmrc|\\.pypirc)$" },
        { "pattern": "(^|/)\\.docker/config\\.json$" },
        { "pattern": "(^|/)\\.env(?:\\.(local|dev|development|test|staging|prod|production))?$" },
        { "pattern": "(^|/)(secrets?|credentials?)(/|$)" },
        { "pattern": "\\.(pem|key|p12|pfx)$" }
      ]
    },
    "edit_file": {
      "default": "allow",
      "always_confirm": [
        { "scope": "outside" },
        { "pattern": "(^|/)\\.(ssh|aws|gnupg|kube|azure)(/|$)" },
        { "pattern": "(^|/)\\.config/(gcloud|gh)(/|$)" },
        { "pattern": "(^|/)(\\.netrc|\\.git-credentials|\\.npmrc|\\.pypirc)$" },
        { "pattern": "(^|/)\\.docker/config\\.json$" },
        { "pattern": "(^|/)\\.env(?:\\.(local|dev|development|test|staging|prod|production))?$" },
        { "pattern": "(^|/)(secrets?|credentials?)(/|$)" },
        { "pattern": "\\.(pem|key|p12|pfx)$" }
      ]
    },
    // Every delete tool call confirms. The list below is not redundant: it is
    // what still protects credentials once you set this default to "allow".
    "delete_path": {
      "default": "confirm",
      "always_confirm": [
        { "scope": "outside" },
        { "pattern": "(^|/)\\.(ssh|aws|gnupg|kube|azure)(/|$)" },
        { "pattern": "(^|/)\\.config/(gcloud|gh)(/|$)" },
        { "pattern": "(^|/)(\\.netrc|\\.git-credentials|\\.npmrc|\\.pypirc)$" },
        { "pattern": "(^|/)\\.docker/config\\.json$" },
        { "pattern": "(^|/)\\.env(?:\\.(local|dev|development|test|staging|prod|production))?$" },
        { "pattern": "(^|/)(secrets?|credentials?)(/|$)" },
        { "pattern": "\\.(pem|key|p12|pfx)$" }
      ]
    },
    // A move is judged on both ends, which closes "rename it out of the way
    // first" — a path a `delete_path` rule alone leaves open.
    "move_path": {
      "default": "allow",
      "always_confirm": [
        { "scope": "outside" },
        { "pattern": "(^|/)\\.(ssh|aws|gnupg|kube|azure)(/|$)" },
        { "pattern": "(^|/)\\.config/(gcloud|gh)(/|$)" },
        { "pattern": "(^|/)(\\.netrc|\\.git-credentials|\\.npmrc|\\.pypirc)$" },
        { "pattern": "(^|/)\\.docker/config\\.json$" },
        { "pattern": "(^|/)\\.env(?:\\.(local|dev|development|test|staging|prod|production))?$" },
        { "pattern": "(^|/)(secrets?|credentials?)(/|$)" },
        { "pattern": "\\.(pem|key|p12|pfx)$" }
      ]
    },
    // ---------------------------------------------------------------------
    // Reads. The same credential patterns, and deliberately no
    // `{ "scope": "outside" }` rule: reading outside the project is ordinary
    // work, and a remote-scheme read (`ssh://host/etc/passwd`) already arrives
    // as `outside`, so that rule would confirm routine reads.
    // ---------------------------------------------------------------------
    "read_file": {
      "default": "allow",
      "always_confirm": [
        { "pattern": "(^|/)\\.(ssh|aws|gnupg|kube|azure)(/|$)" },
        { "pattern": "(^|/)\\.config/(gcloud|gh)(/|$)" },
        { "pattern": "(^|/)(\\.netrc|\\.git-credentials|\\.npmrc|\\.pypirc)$" },
        { "pattern": "(^|/)\\.docker/config\\.json$" },
        { "pattern": "(^|/)\\.env(?:\\.(local|dev|development|test|staging|prod|production))?$" },
        { "pattern": "(^|/)(secrets?|credentials?)(/|$)" },
        { "pattern": "\\.(pem|key|p12|pfx)$" }
      ]
    },
    // ---------------------------------------------------------------------
    // Arbitrary code with no matchable input, so only these defaults apply.
    // `eval` runs in-process, `browser` runs it with a page attached, and
    // `computer` drives the real keyboard, pointer and clipboard of the
    // desktop — including every window that is not omp.
    // ---------------------------------------------------------------------
    "eval": {
      "default": "confirm"
    },
    "browser": {
      "default": "confirm"
    },
    "computer": {
      "default": "deny"
    },
    // ---------------------------------------------------------------------
    // Shell commands. Each pattern is matched against every sub-command
    // separately (a pipeline is split), against each `> target` redirection,
    // and — for a supervised launch — against `PWD=… NAME=value … program args`.
    // A `^` therefore anchors one sub-command, not the whole command line.
    // ---------------------------------------------------------------------
    "terminal": {
      "default": "allow",
      "always_confirm": [
        // Privilege and destruction.
        { "pattern": "\\b(sudo|doas)\\b" },
        { "pattern": "\\b(rm|rmdir|unlink|shred|truncate|dd|mkfs)\\b" },
        { "pattern": "\\b(chmod|chown|chgrp)\\b" },
        { "pattern": "\\b(kill|pkill|killall|shutdown|reboot)\\b" },
        // History and working-tree rewrites.
        //
        // Every rule below that needs two things present in one sub-command is
        // written as two anchored lookaheads and nothing else, because that is
        // what the rule actually means: "this sub-command mentions A and
        // mentions B", in any order. Written the obvious way — `\bA\b[^\n]*B` —
        // the scan restarts at every occurrence of A, so cost grows with the
        // square of the command length, and two such scans in one pattern grow
        // with the cube. Both shapes were measured stalling this gate on a
        // command a model can emit: 18 KB cost 12.6 s, 120 KB cost 4.9 s.
        // A `^`-anchored lookahead runs once and is atomic, so each of these is
        // one linear pass per term. `[\s\S]` rather than `[^\n]` so a multi-line
        // command is not silently reduced to its first line.
        { "pattern": "^(?=[\\s\\S]*\\bgit\\b)(?=[\\s\\S]*\\b(push|reset|clean|restore|rebase)\\b)" },
        { "pattern": "^(?=[\\s\\S]*\\bgit\\b)(?=[\\s\\S]*\\b(checkout|switch)\\b)(?=[\\s\\S]*(--force|--discard-changes|\\s-f(\\s|$)|\\s--\\s))" },
        { "pattern": "^(?=[\\s\\S]*\\bgit\\b)(?=[\\s\\S]*\\bbranch\\b)(?=[\\s\\S]*(\\s-D\\b|\\s-f\\b|\\s-M\\b|--force))" },
        { "pattern": "^(?=[\\s\\S]*\\bgit\\b)(?=[\\s\\S]*\\bstash\\s+(drop|clear)\\b)" },

        // Code that arrives from the network and then runs. Two rules, because
        // the action can be an abbreviation right after the program (`npm i`)
        // or a long name after flags (`npm --prefix /tmp/p install`), and a
        // single pattern covering both would match a bare `i` anywhere.
        { "pattern": "\\b(npm|pnpm|yarn|bun)\\s+(i|in|ins|install|add|rm|un|uninstall|remove|up|update|upgrade|ci|exec|dlx|create|publish|link)\\b" },
        { "pattern": "^(?=[\\s\\S]*\\b(npm|pnpm|yarn|bun)\\b)(?=[\\s\\S]*\\s(install|add|uninstall|remove|update|upgrade|exec|publish)\\b)" },
        { "pattern": "\\b(npx|bunx)\\b|\\b(pnpm|yarn)\\s+dlx\\b" },

        // Infrastructure that acts on something other than this machine.
        { "pattern": "^(?=[\\s\\S]*\\bterraform\\b)(?=[\\s\\S]*\\b(apply|destroy|import)\\b)" },
        { "pattern": "^(?=[\\s\\S]*\\bkubectl\\b)(?=[\\s\\S]*\\b(apply|delete|replace|patch|scale|drain|create|edit|set|rollout|exec|run|cp|annotate|label)\\b)" },
        { "pattern": "^(?=[\\s\\S]*\\bdocker\\b)(?=[\\s\\S]*\\b(rm|rmi|prune|push)\\b)" },

        // Programs that open their own files, which no `write_file` rule can
        // see: only a shell redirection is visible as a write target.
        //
        // Each of these is anchored at the command-name position of one
        // sub-command, because an unanchored `\btee\b` also fires on the word
        // `tee` inside a commit message. The prefix group is what keeps the
        // anchor honest: it steps over `NAME=value` assignments, over the
        // wrapper programs that take a command as their argument, and over a
        // path (`/usr/bin/tee`, `./tee`). It is `[^\s=]+=` and not `\S+=` on
        // purpose: a variable name cannot contain `=`, and `\S+=\S*` could
        // split one word at any of its `=`, which multiplies across words into
        // catastrophic backtracking on a command that matches nothing.
        { "pattern": "^(?:[^\\s=]+=\\S*\\s+|(env|nohup|nice|stdbuf|command|exec|time|xargs)\\s+)*(\\S*/)?(tee|cp|install)\\b" },
        { "pattern": "^(?=[\\s\\S]*\\bsed\\b)(?=[\\s\\S]*(\\s-i|--in-place))" },
        { "pattern": "^(?=[\\s\\S]*\\b(python[0-9.]*|perl|ruby|node|bun|deno)\\b)(?=[\\s\\S]*(\\s-(c|e|p)\\b|--eval\\b|--print\\b|--input-type\\b))" },

        // Code loaded into an otherwise innocuous command through the
        // environment. Matched unanchored, so `env LD_PRELOAD=… node -v` is
        // caught as well as the bare assignment prefix.
        { "pattern": "\\b(NODE_OPTIONS|BASH_ENV|LD_PRELOAD|LD_LIBRARY_PATH|DYLD_INSERT_LIBRARIES|DYLD_LIBRARY_PATH|PYTHONSTARTUP|PERL5OPT|RUBYOPT|GIT_SSH_COMMAND)=" },

        // Credential management: reading or rewriting where secrets live.
        //
        // Two git rules rather than one `credential` scan, because that scan
        // also fired on `git commit -m 'add the credential docs'`, on
        // `git log --grep credential`, and on any path named `credentials.ts`.
        // The subcommand form prints a stored secret; the config form is always
        // spelled `credential.<something>`, and requiring the dot is what keeps
        // the word out of it.
        { "pattern": "\\bgit\\s+credential\\b" },
        { "pattern": "^(?=[\\s\\S]*\\bgit\\b)(?=[\\s\\S]*credential\\.)" },
        { "pattern": "\\bgh\\s+(auth|secret|variable)\\b" },
        { "pattern": "\\baws\\s+(configure|sts|iam|secretsmanager|ssm)\\b" },
        { "pattern": "\\bgcloud\\s+auth\\b|\\baz\\s+(login|keyvault)\\b" },
        { "pattern": "^(?:[^\\s=]+=\\S*\\s+|(env|nohup|nice|stdbuf|command|exec|time|xargs)\\s+)*(\\S*/)?security\\b" },
        { "pattern": "^(?:[^\\s=]+=\\S*\\s+|(env|nohup|nice|stdbuf|command|exec|time|xargs)\\s+)*(\\S*/)?defaults\\s+(write|delete|import)\\b" },
        { "pattern": "^(?:[^\\s=]+=\\S*\\s+|(env|nohup|nice|stdbuf|command|exec|time|xargs)\\s+)*(\\S*/)?(launchctl|crontab)\\b" },

        // Exfiltration: a copy of this machine's files going somewhere else.
        // `ssh` is here because `ssh host < .env` sends a file to a remote
        // machine while the shell's read redirect is not a write target, so
        // nothing else in this file sees it.
        { "pattern": "^(?:[^\\s=]+=\\S*\\s+|(env|nohup|nice|stdbuf|command|exec|time|xargs)\\s+)*(\\S*/)?(scp|sftp|rsync|ssh)\\b" },
        { "pattern": "^(?:[^\\s=]+=\\S*\\s+|(env|nohup|nice|stdbuf|command|exec|time|xargs)\\s+)*(\\S*/)?(nc|ncat|netcat|socat)\\b" },
        // The two curl rules are the only case-sensitive rules in the file, and
        // they have to be: in curl `-T` and `-F` are uploads while `-t` and `-f`
        // are a time-condition and a silent-fail flag, so matching them
        // case-insensitively would confirm every `curl -fsSL`. There is no `\b`
        // after the flag letter, so an attached value (`-Tsecret`,
        // `--upload-file=secret`, `-Ffile=@secret`) is caught too.
        //
        // wget is a separate rule because the same letter means something else
        // there: `wget -T 30` is a timeout, not an upload, and `--method` on its
        // own is not one either, so wget is matched on body-carrying flags only.
        { "pattern": "^(?=[\\s\\S]*\\bcurl\\b)(?=[\\s\\S]*(\\s-T|--upload-file))", "case_sensitive": true },
        { "pattern": "^(?=[\\s\\S]*\\bcurl\\b)(?=[\\s\\S]*(\\s-F|--form|(--data(-binary|-raw|-urlencode)?|\\s-d)[=\\s]*@))", "case_sensitive": true },
        { "pattern": "^(?=[\\s\\S]*\\bwget\\b)(?=[\\s\\S]*(--post-file|--body-file|--body-data))" },

        // A sub-command that is nothing but an interpreter and its flags reads
        // its program from stdin, which is the `curl … | sh` shape. Flags are
        // allowed (`sh -e`, `bash -eux`, `node --input-type=module`) but an
        // operand is not, so `sh -c 'echo hi'` stays out of this rule. The
        // leading guard is for the flags that print and exit instead of reading
        // anything: `node --version` and `ruby --help` are not this shape.
        { "pattern": "^(?!.*(--version|--help|\\s-[hvV](\\s|$)))((ba|z|k|da)?sh|python[0-9.]*|perl|ruby|node|bun|deno)(\\s+-{1,2}[A-Za-z][\\w.=-]*|\\s+-)*\\s*$" }
      ]
    }
  }
}

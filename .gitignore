# Vendored reference sources, read-only. Version is encoded in the directory name.
examples/

node_modules/
dist/
*.log
.DS_Store

# Bun's lockfile is derived: `bun install` migrates package-lock.json, and CI
# reruns that migration on a clean runner. Committing a second lockfile would
# only add a second thing to keep honest.
bun.lock

# Local rasen run state and throwaway probes.
.rasen/

# Agent tooling installed into this checkout, not project content: rasen mirrors
# the same workflow skills into both directories on every install.
.claude/
.omp/
